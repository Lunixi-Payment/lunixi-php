LUNIXI_BASE_URL=https://api-gateway.lunixi.com
LUNIXI_ENVIRONMENT=TEST
LUNIXI_KEY_ID=mk_test_sk_...

# Prefer a file path for private keys. Keep this file outside public web roots.
LUNIXI_PRIVATE_KEY_PATH=/secure/path/lunixi-ed25519-private.pem

# Alternative for local tests only. Use "\n" for newlines if exporting from a shell.
# LUNIXI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Webhook endpoint secret from the Lunixi dashboard.
LUNIXI_WEBHOOK_SECRET=whsec_...

# Optional sample defaults.
LUNIXI_CALLBACK_URL=https://merchant.example.com/payments/lunixi/callback
LUNIXI_CUSTOMER_ID=cust_demo_001
LUNIXI_CARD_USER_KEY=cust_demo_001
LUNIXI_PAYMENT_ID=pay_...
LUNIXI_STORED_CARD_TOKEN=card_...
LUNIXI_PAYMENT_LINK_ID=3f1c2a9e-...
LUNIXI_IMAGE_FILE=/path/to/cover.png

# Wallet samples (08-wallet). The key needs the WALLET_SERVICE product and the
# wallet scopes named in each sample.
LUNIXI_WALLET_PROGRAM_ID=...
LUNIXI_WALLET_END_USER_ID=...
LUNIXI_WALLET_ACCOUNT_ID=...
LUNIXI_WALLET_EXTERNAL_CUSTOMER_ID=cust_demo_001
LUNIXI_WALLET_PHONE=+905350000000
LUNIXI_WALLET_DESTINATION_WALLET_NO=...
LUNIXI_WALLET_BUYER_WALLET_NO=...
# Bulk payouts are four-eyes: a second key (wallet:bulk:approve) approves and processes.
LUNIXI_WALLET_APPROVER_KEY_ID=mk_test_sk_...
LUNIXI_WALLET_APPROVER_PRIVATE_KEY_PATH=/secure/path/lunixi-approver-private.pem
# Business references the samples derive their Idempotency-Keys from.
LUNIXI_WALLET_TRANSFER_REF=TRF-20261006-0001
LUNIXI_WALLET_ORDER_REF=ORD-20261006-0001
LUNIXI_WALLET_TOPUP_REF=TOP-20261006-0001
LUNIXI_WALLET_PAYROLL_REF=PAYROLL-2026-10

# Bank account samples (09-bank-accounts). The key needs the BANK_CONNECT product,
# `bank-connect:view` and, for balances and transactions, `bank-connect:transactions:view`.
LUNIXI_BANK_ACCOUNT_ID=...

# Insurance samples (10-insurance). The key needs the INSURANCE_SERVICE product and an
# active insurance connection in the dashboard. The insured's details come from your
# checkout form; fill them only with test data you are allowed to use.
LUNIXI_INSURED_IDENTITY_TYPE=PASSPORT
LUNIXI_INSURED_IDENTITY_NUMBER=
LUNIXI_INSURED_BIRTH_DATE=
LUNIXI_INSURED_EMAIL=
LUNIXI_INSURED_PHONE=
LUNIXI_TICKET_PNR=
LUNIXI_TICKET_NUMBER=
LUNIXI_INSURANCE_ORDER_ID=inso_...
LUNIXI_INSURANCE_POLICY_ID=insp_...
LUNIXI_EXTERNAL_PAYMENT_ID=
LUNIXI_EXTERNAL_REFUND_ID=
