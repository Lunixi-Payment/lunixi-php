{
  "name": "lunixi/yii-checkout-example",
  "description": "Runnable Yii 2 invoice checkout with shared Lunixi Commerce",
  "type": "project",
  "license": "BSD-3-Clause",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "ext-curl": "*",
    "yiisoft/yii2": "2.0.55",
    "lunixi/php-sdk": "^0.29.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "replace": {
    "bower-asset/jquery": ">=1.11.0",
    "bower-asset/inputmask": ">=3.2.0",
    "bower-asset/punycode": ">=1.3.0",
    "bower-asset/yii2-pjax": ">=2.0.0"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
