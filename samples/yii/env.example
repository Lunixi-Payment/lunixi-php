# Copy to .env, fill values, then explicitly load into your shell with: set -a; . ./.env; set +a
# Only loopback development may use local HTTP. For deployment: APP_ENV=prod, YII_LOCAL_HTTP=0.
APP_ENV=dev
YII_LOCAL_HTTP=1
APP_LANGUAGE=en
YII_COOKIE_KEY=''
LUNIXI_MERCHANT_ID=''
LUNIXI_ENVIRONMENT=TEST
LUNIXI_KEY_ID=''
LUNIXI_PRIVATE_KEY=''
LUNIXI_WEBHOOK_SECRET=''
LUNIXI_ENCRYPTION_KEY=''
LUNIXI_APP_URL='https://billing.example'
LUNIXI_CHECKOUT_MODE=embedded
LUNIXI_PREAUTH=false
DEMO_ALICE_PASSWORD=''
DEMO_BOB_PASSWORD=''
