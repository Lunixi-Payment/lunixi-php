{
  "name": "lunixi/codeigniter-checkout-example",
  "description": "Runnable CodeIgniter 4 invoice checkout with shared Lunixi Commerce",
  "license": "MIT",
  "type": "project",
  "homepage": "https://docs.lunixi.com/en/sdks/codeigniter",
  "support": {
    "source": "https://github.com/Lunixi-Payment/lunixi-php"
  },
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "4.7.5",
    "lunixi/php-sdk": "^0.29.5",
    "ext-sodium": "*",
    "ext-curl": "*",
    "ext-sqlite3": "*"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9",
    "mikey179/vfsstream": "^1.6",
    "phpunit/phpunit": "^10.5.16",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Support\\": "tests/_support"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit"
  }
}
