# Local loopback development; do not expose this HTTP server publicly.
CI_ENVIRONMENT = production
app.baseURL = 'http://localhost:8080/'
# For deployment use HTTPS, app.forceGlobalSecureRequests=true and cookie.secure=true.
LUNIXI_MERCHANT_ID = ''
LUNIXI_ENVIRONMENT = TEST
LUNIXI_KEY_ID = ''
LUNIXI_PRIVATE_KEY = ''
LUNIXI_WEBHOOK_SECRET = ''
# Independent base64-encoded 32 random bytes. Keep outside public/ and back up separately.
LUNIXI_ENCRYPTION_KEY = ''
# Public HTTPS origin registered with Lunixi; use a TLS tunnel for real TEST checkout.
LUNIXI_APP_URL = 'https://billing.example'
LUNIXI_CHECKOUT_MODE = hosted
LUNIXI_PREAUTH = false
DEMO_ALICE_PASSWORD = ''
DEMO_BOB_PASSWORD = ''
